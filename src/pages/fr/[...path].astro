---
import ScrollingArticle from "../../components/ScrollingArticle.astro";
import SeriesLabel from "../../components/SeriesLabel.astro";
import EditorialImage from "../../components/EditorialImage.astro";
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import {published,categories,slug,readingTime,date,url} from '../../lib/content';
import {categoryFr,frUrl} from '../../lib/i18n';
import {render} from 'astro:content';
export async function getStaticPaths(){const articles=await published('fr');const tags=[...new Set(articles.flatMap(a=>a.data.tags).map(slug))];const paths=['','essays','categories','about','contact','privacy','404',...categories.map(c=>`categories/${slug(c)}`),...tags.map(t=>`tags/${t}`),...articles.map(a=>`essays/${a.id}`)];return paths.map(path=>({params:{path:path||undefined}}));}
const path=Astro.params.path||'';const articles=await published('fr');const article=articles.find(a=>path===`essays/${a.id}`);const category=categories.find(c=>path===`categories/${slug(c)}`);const tag=path.startsWith('tags/')?path.slice(5):undefined;
const featured=articles[0];const titles:Record<string,string>={'':'Accueil',essays:'Essais',categories:'Explorer par thème',about:'À propos',contact:'Contact',privacy:'Confidentialité','404':'Page introuvable'};
const title=article?.data.title||(category?categoryFr[category]:tag?`#${tag}`:titles[path]);
const rendered=article?await render(article):undefined;const Content=rendered?.Content;
const index=article?articles.findIndex(a=>a.id===article.id):-1;const previous=articles[index+1];const next=articles[index-1];const related=article?articles.filter(a=>a.id!==article.id&&(a.data.category===article.data.category||a.data.tags.some(t=>article.data.tags.includes(t)))).slice(0,3):[];
const intro='Essais sur la foi, le patrimoine et un monde en mouvement, à travers le regard d’une femme algérienne musulmane.';
---
<Base title={title} description={article?.data.description||intro} language="fr" article={!!article} pubDate={article?.data.pubDate} updatedDate={article?.data.updatedDate}>
{path===''&&<><p class="intro">{intro}</p>{featured&&<article class:list={["feature",{"feature-with-cover":!!featured.data.cover}]}>{featured.data.cover&&<EditorialImage {...featured.data.cover} caption={undefined} credit={undefined} creditUrl={undefined} preview loading="eager"/>}<div class="meta">À la une / {categoryFr[featured.data.category]}</div><SeriesLabel series={featured.data.series} french/><h1 lang={featured.data.language}><a href={frUrl(`essays/${featured.id}/`)}>{featured.data.title}</a></h1><p lang={featured.data.language}>{featured.data.description}</p><div class="meta">{date(featured.data.pubDate,'fr')} · {readingTime(featured)} min de lecture · {featured.data.language==='fr'?'Français':'Anglais'}{featured.data.placeholder&&' · Texte provisoire'}</div><a class="text-link" href={frUrl(`essays/${featured.id}/`)}>Lire l’essai ↗</a></article>}{articles.length>1&&<><div class="section-heading"><h2>Derniers écrits</h2><a href={frUrl('essays/')}>Tous les essais ↗</a></div><ArticleList french articles={articles.slice(1,6)}/></>}<section class="subjects"><h2 class="meta">Explorer par thème</h2><div class="subject-links">{categories.map(c=><a href={frUrl(`categories/${slug(c)}/`)}>{categoryFr[c]}</a>)}</div></section><section class="author"><h2>Une voix sous les plis.</h2><p class="meta">Par Safaa wa Noor</p><p>Une femme algérienne musulmane écrit au croisement de la foi, du patrimoine, de la technologie et de la vie contemporaine. Un espace de questionnement et de réflexion personnelle.</p><a class="text-link" href={frUrl('about/')}>À propos de la revue ↗</a></section></>}
{(path==='essays'||category||tag)&&<><header class="page-header"><h1>{title}</h1>{path==='essays'&&<p>Chaque essai est proposé dans sa langue d’origine, indiquée sous le titre.</p>}</header><ArticleList french articles={articles.filter(a=>category?a.data.category===category:tag?a.data.tags.some(t=>slug(t)===tag):true)}/></>}
{path==='categories'&&<><header class="page-header"><h1>Explorer par thème</h1><p>Des fils différents, une curiosité commune.</p></header>{categories.map(c=><section class="article-row"><div class="meta">{articles.filter(a=>a.data.category===c).length} texte(s)</div><h2><a href={frUrl(`categories/${slug(c)}/`)}>{categoryFr[c]}</a></h2></section>)}</>}
{path==='about'&&<article class="prose"><div class="meta">À propos de la revue</div><h1>Une voix sous les plis.</h1><p class="meta">Safaa wa Noor</p><aside class="notice">Biographie provisoire — à relire et à personnaliser avant publication.</aside><p>Je suis une femme algérienne musulmane qui écrit au croisement de la foi, du patrimoine, de la technologie et de la vie contemporaine.</p><p>Under the Haik est une revue indépendante consacrée aux questions qui nous accompagnent : comment vivre notre foi, accueillir notre héritage et trouver notre voie dans un monde en mouvement.</p><p>Le patrimoine algérien et amazigh y côtoie des réflexions sur la condition féminine musulmane, l’histoire de l’Afrique du Nord, la société, la maternité et la culture numérique. Ces thèmes sont liés par le désir d’observer avec attention et d’écrire avec rigueur.</p><h2>À propos des écrits religieux</h2><p>Les articles consacrés à la religion sont des réflexions personnelles et des recherches. Ils ne constituent ni des fatwas ni un substitut aux conseils de savants qualifiés. Les sources et les limites d’un point de vue personnel ont toute leur place ici.</p></article>}
{path==='contact'&&<article class="prose"><h1>Entrons en contact.</h1><p>Une adresse électronique dédiée ou un formulaire de contact pourra être ajouté ici ultérieurement.</p><p>Aucun formulaire de contact n’est connecté pour le moment.</p></article>}
{path==='privacy'&&<article class="prose"><h1>Un espace paisible pour lire.</h1><p>Ce site n’intègre aucun outil d’analyse d’audience, traceur publicitaire ou cookie. Aucun formulaire de contact ni service d’abonnement par courriel n’est connecté.</p><h2>Votre préférence de lecture</h2><p>Si vous choisissez le mode sombre, le site conserve cette préférence dans le stockage de session de votre navigateur, pour l’onglet en cours. Elle n’est pas transmise à l’autrice et disparaît à la fin de la session du navigateur. Le site fonctionne également si ce stockage est indisponible.</p><h2>Hébergement et liens externes</h2><p>L’hébergeur peut traiter des informations techniques lorsqu’il affiche une page. Sa propre politique de confidentialité s’applique à ce traitement. Les liens vers d’autres sites conduisent à des services ayant leurs propres pratiques.</p><p>Cette page décrit les fonctionnalités actuellement présentes et devra être réexaminée si de nouveaux services sont ajoutés.</p></article>}
{path==='404'&&<article class="prose"><h1>Cette page est introuvable.</h1><p>L’adresse a peut-être changé, ou l’essai n’a pas encore été publié.</p><a class="text-link" href={frUrl('essays/')}>Parcourir les essais →</a></article>}
{article&&Content&&<><article class="prose editorial-prose"><a class="text-link" href={frUrl('essays/')}>← Tous les essais</a><p class="meta"><a href={frUrl(`categories/${slug(article.data.category)}/`)}>{categoryFr[article.data.category]}</a> / {article.data.language==='fr'?'Français':'Anglais'}</p><SeriesLabel series={article.data.series} french/><h1 lang={article.data.language}>{article.data.title}</h1><div class="meta">{date(article.data.pubDate,'fr')} · {readingTime(article)} min de lecture{article.data.updatedDate&&` · Mis à jour le ${date(article.data.updatedDate,'fr')}`}</div>{article.data.placeholder&&<aside class="notice">Texte provisoire — à remplacer avant publication.</aside>}{article.data.language==='en'&&<p class="notice">Cet essai est disponible en anglais. Son texte est conservé dans sa langue d’origine.</p>}{article.data.coverLayout==='side'&&article.data.cover?<div class="article-body-side" lang={article.data.language} dir="auto"><EditorialImage {...article.data.cover} loading="eager" display="portrait"/><Content/></div>:article.data.cover?<ScrollingArticle cover={article.data.cover} language={article.data.language}><Content/></ScrollingArticle>:<>{article.data.coverImage&&<img src={url(article.data.coverImage)} alt={article.data.coverAlt} loading="eager"/>}<div lang={article.data.language} dir="auto"><Content/></div></>}{article.data.category==='Faith'&&<aside class="notice">Réflexion personnelle et recherche : ce texte ne constitue pas une fatwa et ne remplace pas les conseils de savants qualifiés.</aside>}<div class="article-tags">{article.data.tags.map(t=><a href={frUrl(`tags/${slug(t)}/`)}>#{t}</a>)}</div><button class="share" hidden>Copier le lien</button><span class="status" role="status"></span><nav class="article-navigation" aria-label="Essais précédent et suivant">{previous&&<a href={frUrl(`essays/${previous.id}/`)}><span class="meta">← Essai précédent</span><span lang={previous.data.language}>{previous.data.title}</span></a>}{next&&<a href={frUrl(`essays/${next.id}/`)}><span class="meta">Essai suivant →</span><span lang={next.data.language}>{next.data.title}</span></a>}</nav></article>{related.length>0&&<section><h2>À lire aussi</h2><ArticleList french articles={related}/></section>}</>}
</Base>
<script>
const button=document.querySelector<HTMLButtonElement>('.share');const status=document.querySelector<HTMLElement>('.status');if(button&&status){button.hidden=false;button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href||location.href);status.textContent='Lien copié.';}catch{status.textContent='Copiez l’adresse dans la barre d’adresse de votre navigateur.';}});}
</script>

